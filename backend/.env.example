# Copy to .env and fill in. All keys are OPTIONAL for local dev:
# without them the backend serves realistic mock data so you can run the
# app end-to-end before signing up for anything.

# Real-time quotes + company news + earnings. Free tier: https://finnhub.io
FINNHUB_API_KEY=

# Claude — powers the AI portfolio brief and news summaries.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for briefs.
CLAUDE_MODEL=claude-sonnet-5
