# Copy to .env and fill in. Everything here is OPTIONAL.
#
# Market data: by default the app uses Yahoo Finance's public API — REAL live
# prices, history, and news with NO API KEY. On a network with internet access
# it "just works". In locked-down/offline environments it falls back to mock
# data automatically.

# Provider: "auto" (finnhub if a key is set, else yahoo), "yahoo", "finnhub",
# or "mock" (force offline demo data).
MARKET_PROVIDER=auto

# Only needed if you want to use Finnhub instead of Yahoo. https://finnhub.io
FINNHUB_API_KEY=

# Paper-trading starting cash for a new account.
STARTING_CASH=100000

# Claude — powers the AI portfolio brief and news summaries.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for briefs.
CLAUDE_MODEL=claude-sonnet-5

# Signs auth tokens. CHANGE THIS in production to a long random string.
JWT_SECRET=dev-insecure-change-me
