{
  "name": "concierge-native",
  "version": "0.1.0",
  "private": true,
  "description": "Native iOS/Android shell for the Concierge app (Capacitor).",
  "scripts": {
    "sync:web": "./sync-web.sh",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "sync": "npm run sync:web && cap sync",
    "icons": "capacitor-assets generate --assetPath assets"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
