# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# Get a key from https://console.anthropic.com/ (use a test/low-limit key
# while you're validating the harness — a confused agent is capped at
# MAX_STEPS per task, but you still don't want a production key here).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Optional ----

# Hosted browser (recommended in production). With these set, the agent drives
# a Browserbase browser instead of a local Chromium. Leave blank to run local.
#   Sign up at https://www.browserbase.com/ to get these.
# BROWSERBASE_API_KEY=bb_...
# BROWSERBASE_PROJECT_ID=...
# BROWSERBASE_CONNECT_URL=          # advanced: override the full CDP URL

# Pin a local Chromium binary (Docker/CI). Leave unset on a normal machine.
# PLAYWRIGHT_CHROMIUM_PATH=

# CORS origins for the native app / other clients (comma-separated, or *).
# ALLOWED_ORIGINS=*

# Confirmation emails. With no key set, emails are written to data/outbox/
# (console mode) so you can see them without sending. Set one provider key to
# send for real, and a verified From address.
# EMAIL_PROVIDER=resend           # resend | postmark | sendgrid | console
# RESEND_API_KEY=re_...
# POSTMARK_API_KEY=...
# SENDGRID_API_KEY=...
# EMAIL_FROM=Concierge <bookings@yourdomain.com>

# Real bookings: with this set, known venues route to their real reservation
# page (see REAL_VENUE_URLS in adapters.py) instead of the local demo flow.
# Requires ANTHROPIC_API_KEY (and ideally BROWSERBASE_API_KEY). Leave unset
# for the safe demo.
# REAL_BOOKING=1

# Restaurant data. Unset -> the built-in curated catalog (many real venues).
# Set a provider + key to pull the live database of *every* restaurant.
# PROVIDER = yelp | google
# VENUE_PROVIDER=yelp
# YELP_API_KEY=...
# GOOGLE_PLACES_API_KEY=...

# Database. Unset -> SQLite at data/app.db (default). Set a postgres:// URL
# (Supabase/Neon/RDS) to use Postgres instead — same schema, no code change.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Phone-agent: with a provider key set, /call places a real AI phone call to
# the venue. Without one it runs a simulated (dry-run) call. Providers:
# vapi | bland | retell | twilio.
# PHONE_PROVIDER=vapi
# VAPI_API_KEY=...
# PHONE_FROM_NUMBER=+15551234567
