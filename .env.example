# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# Get a key from https://console.anthropic.com/ (use a test/low-limit key
# while you're validating the harness — a confused agent is capped at
# MAX_STEPS per task, but you still don't want a production key here).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Optional ----

# Hosted browser (recommended in production). With these set, the agent drives
# a Browserbase browser instead of a local Chromium. Leave blank to run local.
#   Sign up at https://www.browserbase.com/ to get these.
# BROWSERBASE_API_KEY=bb_...
# BROWSERBASE_PROJECT_ID=...
# BROWSERBASE_CONNECT_URL=          # advanced: override the full CDP URL

# Pin a local Chromium binary (Docker/CI). Leave unset on a normal machine.
# PLAYWRIGHT_CHROMIUM_PATH=

# CORS origins for the native app / other clients (comma-separated, or *).
# ALLOWED_ORIGINS=*
