{
  "components": {
    "schemas": {
      "CommandIn": {
        "properties": {
          "command": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Command",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "title": "CommandIn",
        "type": "object"
      },
      "CommandOut": {
        "properties": {
          "command": {
            "title": "Command",
            "type": "string"
          },
          "executed_at": {
            "format": "date-time",
            "title": "Executed At",
            "type": "string"
          }
        },
        "required": [
          "command",
          "executed_at"
        ],
        "title": "CommandOut",
        "type": "object"
      },
      "FunctionSpec": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Args",
            "type": "array"
          },
          "available": {
            "default": false,
            "title": "Available",
            "type": "boolean"
          },
          "code": {
            "pattern": "^[A-Z][A-Z0-9]{1,5}$",
            "title": "Code",
            "type": "string"
          },
          "group": {
            "title": "Group",
            "type": "string"
          },
          "needs_security": {
            "default": false,
            "title": "Needs Security",
            "type": "boolean"
          },
          "phase": {
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Phase",
            "type": "integer"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "phase",
          "group",
          "summary"
        ],
        "title": "FunctionSpec",
        "type": "object"
      },
      "FunctionsConfig": {
        "additionalProperties": false,
        "properties": {
          "functions": {
            "items": {
              "$ref": "#/components/schemas/FunctionSpec"
            },
            "title": "Functions",
            "type": "array"
          },
          "market_suffixes": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Market Suffixes",
            "type": "object"
          },
          "sector_suffixes": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Sector Suffixes",
            "type": "object"
          }
        },
        "required": [
          "functions",
          "market_suffixes",
          "sector_suffixes"
        ],
        "title": "FunctionsConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "worker_last_seen": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Last Seen"
          }
        },
        "required": [
          "status",
          "version",
          "mode",
          "checks",
          "worker_last_seen"
        ],
        "title": "Health",
        "type": "object"
      },
      "LayoutIn": {
        "properties": {
          "layout": {
            "additionalProperties": true,
            "title": "Layout",
            "type": "object"
          }
        },
        "required": [
          "layout"
        ],
        "title": "LayoutIn",
        "type": "object"
      },
      "LayoutOut": {
        "properties": {
          "form_factor": {
            "enum": [
              "desktop",
              "tablet"
            ],
            "title": "Form Factor",
            "type": "string"
          },
          "layout": {
            "additionalProperties": true,
            "title": "Layout",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "name",
          "form_factor",
          "layout",
          "updated_at"
        ],
        "title": "LayoutOut",
        "type": "object"
      },
      "ProviderState": {
        "enum": [
          "connected",
          "idle",
          "degraded",
          "error",
          "unconfigured",
          "disabled"
        ],
        "title": "ProviderState",
        "type": "string"
      },
      "ProviderStatus": {
        "properties": {
          "attribution_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution Text"
          },
          "budget_warning": {
            "default": false,
            "title": "Budget Warning",
            "type": "boolean"
          },
          "cost_tier": {
            "title": "Cost Tier",
            "type": "string"
          },
          "daily_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Limit"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_message_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Message At"
          },
          "latency_class": {
            "title": "Latency Class",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ProviderState"
          },
          "used_today": {
            "default": 0,
            "title": "Used Today",
            "type": "integer"
          },
          "ws_symbol_cap": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ws Symbol Cap"
          }
        },
        "required": [
          "id",
          "display_name",
          "state",
          "cost_tier",
          "latency_class"
        ],
        "title": "ProviderStatus",
        "type": "object"
      },
      "Status": {
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "base_currency": {
            "title": "Base Currency",
            "type": "string"
          },
          "features": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Features",
            "type": "object"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "as_of",
          "mode",
          "base_currency",
          "providers",
          "features"
        ],
        "title": "Status",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkspaceSummary": {
        "properties": {
          "form_factor": {
            "enum": [
              "desktop",
              "tablet"
            ],
            "title": "Form Factor",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "name",
          "form_factor",
          "updated_at"
        ],
        "title": "WorkspaceSummary",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "QUARRY API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/functions": {
      "get": {
        "operationId": "list_functions_api_functions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionsConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Functions",
        "tags": [
          "terminal"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/history": {
      "get": {
        "operationId": "recent_history_api_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CommandOut"
                  },
                  "title": "Response Recent History Api History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recent History",
        "tags": [
          "workspaces"
        ]
      },
      "post": {
        "operationId": "add_history_api_history_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add History",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/status": {
      "get": {
        "operationId": "status_api_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status",
        "tags": [
          "system"
        ]
      }
    },
    "/api/workspaces": {
      "get": {
        "operationId": "list_workspaces_api_workspaces_get",
        "parameters": [
          {
            "in": "query",
            "name": "form_factor",
            "required": false,
            "schema": {
              "default": "desktop",
              "enum": [
                "desktop",
                "tablet"
              ],
              "title": "Form Factor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkspaceSummary"
                  },
                  "title": "Response List Workspaces Api Workspaces Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Workspaces",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/api/workspaces/{name}": {
      "delete": {
        "operationId": "delete_workspace_api_workspaces__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 _\\-]{0,63}$",
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "form_factor",
            "required": false,
            "schema": {
              "default": "desktop",
              "enum": [
                "desktop",
                "tablet"
              ],
              "title": "Form Factor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Workspace",
        "tags": [
          "workspaces"
        ]
      },
      "get": {
        "operationId": "get_workspace_api_workspaces__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 _\\-]{0,63}$",
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "form_factor",
            "required": false,
            "schema": {
              "default": "desktop",
              "enum": [
                "desktop",
                "tablet"
              ],
              "title": "Form Factor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayoutOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Workspace",
        "tags": [
          "workspaces"
        ]
      },
      "put": {
        "operationId": "save_workspace_api_workspaces__name__put",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 _\\-]{0,63}$",
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "form_factor",
            "required": false,
            "schema": {
              "default": "desktop",
              "enum": [
                "desktop",
                "tablet"
              ],
              "title": "Form Factor",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LayoutIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayoutOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Workspace",
        "tags": [
          "workspaces"
        ]
      }
    }
  }
}
