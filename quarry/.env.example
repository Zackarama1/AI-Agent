# QUARRY configuration. Copy to `.env` (git-ignored) and fill in what you have.
# Every provider key is optional: without its key a provider shows "unconfigured" on STAT.
# Never commit real keys. Never paste them into chat.

MODE=personal                 # personal | professional
ENV=dev                       # dev | test | prod
BASE_CURRENCY=GBP
LOG_LEVEL=INFO

# Bind address. Keep 127.0.0.1 and reach the iPad over Tailscale (docs/DEPLOY.md).
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://quarry:quarry@localhost:5432/quarry
REDIS_URL=redis://localhost:6379/0

# Contact for the SEC EDGAR User-Agent (required by SEC; used from Phase 3).
SEC_USER_AGENT="QUARRY/0.1 (contact: you@example.com)"

# ---- Free data providers (Phase 1 needs the first four) ----
FINNHUB_API_KEY=              # https://finnhub.io/register
ALPACA_API_KEY_ID=            # https://alpaca.markets (free account -> API keys)
ALPACA_API_SECRET_KEY=
TWELVEDATA_API_KEY=           # https://twelvedata.com/pricing (Basic)
FRED_API_KEY=                 # https://fred.stlouisfed.org/docs/api/api_key.html
FMP_API_KEY=                  # https://site.financialmodelingprep.com/developer/docs
EODHD_API_KEY=                # https://eodhd.com (free plan)
COMPANIES_HOUSE_API_KEY=      # https://developer.company-information.service.gov.uk
COINGECKO_API_KEY=            # https://www.coingecko.com/en/api (Demo)
OANDA_API_TOKEN=              # OANDA v20 practice account
MARKETAUX_API_KEY=            # https://www.marketaux.com
OPENFIGI_API_KEY=             # optional; raises OpenFIGI limits

# ---- AI layer (Phase 4) ----
ANTHROPIC_API_KEY=
