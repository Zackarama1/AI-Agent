# Copy to .env (or set in your host's dashboard). Only JWT_SECRET is required in production.
NODE_ENV=production
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=/data/collabify.db
APP_URL=https://collabify.example.com

# Business model
PLATFORM_COMMISSION_RATE=0.15
PREMIUM_STUDENT_COMMISSION_RATE=0.10
FEATURED_LISTING_FEE_PENCE=999

# Payments: "mock" (demo, no real money) or "stripe" (Stripe Connect escrow)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Extra university email domains to accept (comma separated), in addition to .ac.uk, .edu, etc.
ACADEMIC_DOMAINS=
